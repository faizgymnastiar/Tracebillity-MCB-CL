# Salin menjadi deployment/.env lalu sesuaikan. docker compose membacanya otomatis.
# Berkas .env tidak ikut ter-commit.

# --- Port & jaringan -------------------------------------------------------
TRACE_PUBLIC_PORT=8080

# --- Keamanan antar-container ---------------------------------------------
# Kunci komunikasi internal trace-web -> trace-api (header x-trace-internal-key).
# Samakan di kedua service; kosongkan hanya untuk uji lokal.
TRACE_INTERNAL_API_KEY=

# --- Basis data & sesi (Fase 1) -------------------------------------------
# Lokasi basis data SQLite di dalam container (sudah dipetakan ke volume trace-data).
TRACE_DB_PATH=data/traceability.db
# true = login email/password + hak operasi ditegakkan backend.
# false = mode demo lama memakai header konteks; jangan dipakai di produksi.
TRACE_AUTH_ENFORCED=true
# Masa berlaku sesi login (jam). Sesi dapat dihentikan dari tab Akun & Izin.
TRACE_SESSION_LIFETIME_HOURS=12

# --- Admin awal -----------------------------------------------------------
# Dibuat hanya saat tabel akun masih kosong. Email wajib; password kosong
# berarti backend membuat password sementara dan mencetaknya SEKALI di log.
# Tabel akun yang sudah berisi data tidak pernah disentuh ulang oleh provisioning.
TRACE_BOOTSTRAP_EMAIL=
TRACE_BOOTSTRAP_PASSWORD=

# --- Stok label QR internal NG (Fase 2) -----------------------------------
# Batas terukur jumlah label per permintaan generate (dan per job cetak).
# Ini BUKAN batas jumlah label sepanjang umur sistem — sequence terus naik tanpa batas.
TRACE_LABEL_MAX_PER_REQUEST=500
# Catatan penerbitan label (append-only, di luar file basis data). Kosongkan untuk
# memakai default: label-issuance.log di samping file basis data.
TRACE_LABEL_LEDGER_PATH=/var/lib/trace-labels/label-issuance.log

# --- Karantina, rework, dan OK akhir (Fase 3) -----------------------------
# Batas percobaan rework per unit seumur hidup (lintas pos, defect, operator,
# shift, dan WO). Default 3. Unit yang mencapai batas masuk Tahan QC.
TRACE_NG_MAX_ATTEMPTS=3
