{
  "Urls": "http://127.0.0.1:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://127.0.0.1:3001",
      "http://localhost:3001"
    ]
  },
  "Trace": {
    "InternalApiKey": "",
    "Db": {
      "Provider": "sqlite",
      "Path": "data/traceability.db"
    },
    "Auth": {
      "Enforced": true
    },
    "Session": {
      "LifetimeHours": 12
    },
    "BootstrapAdmin": {
      "Email": "",
      "Password": ""
    }
  }
}
